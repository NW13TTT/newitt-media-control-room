{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newitt-media-control-room",
  "main": "./control-room-worker.js",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./build/web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/media/photos", "/api/media/photos/*"]
  },
  "env": {
    "media-staging": {
      "name": "newitt-media-control-room-media-staging",
      "assets": {
        "directory": "./build/web",
        "binding": "ASSETS",
        "run_worker_first": ["/api/media/photos", "/api/media/photos/*"]
      },
      "r2_buckets": [
        { "binding": "WEBSITE_MEDIA", "bucket_name": "newitt-control-room-media-staging" }
      ],
      "images": { "binding": "IMAGES" }
    }
  }
}
